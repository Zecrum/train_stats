# Connexion MySQL (partagée avec le collecteur)
# Les routes /api/stats sont en lecture seule, mais /api/admin écrit via ce même
# utilisateur — il a donc besoin de SELECT + INSERT/UPDATE/DELETE sur trains/train_sets :
#   GRANT SELECT, INSERT, UPDATE, DELETE ON rer_e_stats.trains      TO 'rer_e_readonly'@'localhost';
#   GRANT SELECT, INSERT, UPDATE, DELETE ON rer_e_stats.train_sets  TO 'rer_e_readonly'@'localhost';
DB_HOST=localhost
DB_USER=rer_e_readonly
DB_PASSWORD=
DB_NAME=rer_e_stats
PORT=3051

# Origines autorisées pour le front (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# Panel admin (/api/admin) — mot de passe en clair (comparaison à temps constant)
# et secret de signature JWT. Générer un secret aléatoire, ex: openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
